# Turso Database Configuration
# Dapatkan URL dan Token dari: turso db create aurakomik / turso db tokens create aurakomik
# Untuk local development tanpa Turso cloud, biarkan kosong atau gunakan file:aurakomik.db

TURSO_DATABASE_URL=libsql://[your-database-name].turso.io
TURSO_AUTH_TOKEN=your-turso-auth-token
